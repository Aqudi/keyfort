{
  "manifest_version": 3,
  "name": "1PW Clone (Vaultwarden Client)",
  "version": "0.1.0",
  "description": "1Password-style browser extension for your self-hosted Vaultwarden vault.",
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "1PW Clone"
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "permissions": ["storage", "activeTab", "scripting", "alarms"],
  "host_permissions": [
    "https://localhost:8443/*",
    "https://*/*",
    "http://*/*"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content.js"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "src/options.html"
}
